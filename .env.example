# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:4200

# OIDC/Auth0 Provider Configuration
# You can use either OIDC_* or AUTH0_* prefixed variables
OIDC_ISSUER=https://your-auth0-domain.auth0.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Optional: Custom logout configuration
OIDC_LOGOUT_URL=https://your-auth0-domain.auth0.com/v2/logout
OIDC_LOGOUT_RETURN_TO=http://localhost:4200

# Alternative: Legacy Auth0 variable names (if not using OIDC_*)
# AUTH0_ISSUER=https://your-auth0-domain.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
