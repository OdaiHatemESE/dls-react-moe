generator client {
  provider = "prisma-client-js"
  // Generate a separate client so it doesn't conflict with the default @prisma/client
  // This allows importing via: import { PrismaClient } from "@prisma/client-parent-portal";
  output   = "../../node_modules/@prisma/client-parent-portal"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model UpdateInformationRequests {
  Id                       Int       @default(autoincrement())
  studentPersonId          String    @db.VarChar(64)
  parentPersonId           String?   @db.VarChar(64)
  isInfoUpdateRequested    Boolean?  @default(false, map: "DEFAULT_UpdateInformationRequests_isInfoUpdateRequested")
  infoUpdateRequestStatus  String?   @db.VarChar(50)
  isConductAgreementSigned Boolean?  @default(false, map: "DEFAULT_UpdateInformationRequests_isConductAgreementSigned")
  conductAgreementStatus   String?   @db.NVarChar(50)
  studentEmirateId         String?   @db.VarChar(64)
  createAt                 DateTime? @db.DateTime
  updateAt                 DateTime? @db.DateTime

  @@id([Id, studentPersonId], map: "PK_UpdateInformationRequests")
}
