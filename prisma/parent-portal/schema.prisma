generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-parent-portal"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model UpdateInformationRequests {
  Id                       Int       @default(autoincrement())
  studentPersonId          String    @unique(map: "UQ_UpdateInformationRequests_studentPersonId") @db.VarChar(64)
  parentPersonId           String?   @db.VarChar(64)
  isInfoUpdateRequested    Boolean?  @default(false, map: "DEFAULT_UpdateInformationRequests_isInfoUpdateRequested")
  infoUpdateRequestStatus  Int?
  isConductAgreementSigned Boolean?  @default(false, map: "DEFAULT_UpdateInformationRequests_isConductAgreementSigned")
  conductAgreementStatus   Int?
  studentEmirateId         String?   @db.VarChar(64)
  createAt                 DateTime? @db.DateTime
  updateAt                 DateTime? @db.DateTime
  citizenship              String?   @db.VarChar(64)
  pdfBase64                String?   @db.VarChar(Max)

  @@id([Id, studentPersonId], map: "PK_UpdateInformationRequests")
}

model Student {
  id                       Int                 @id @default(autoincrement())
  orSourcedId              String              @unique
  username                 String
  status                   String
  role                     String
  firstNameArabic          String?
  middleNameArabic         String?
  lastNameArabic           String?
  gender                   String?
  dateOfBirth              DateTime?
  religion                 String?
  emirateId                String?
  firstNameEnglish         String?
  middleNameEnglish        String?
  thirdNameEnglish         String?
  fourthNameEnglish        String?
  familyNameEnglish        String?
  studentNumber            String?
  userIds                  String?
  NationalityAR            String?
  NationalityEN            String?
  CitizenshipStatus        String?
  birthPlaceCityAr         String?
  birthPlaceCityEn         String?
  birthPlaceCountryAr      String?
  birthPlaceCountryEn      String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime
  isInformationUpdated     Boolean             @default(false)
  informationUpdatedAt     DateTime?
  isConductAgreementSigned Boolean             @default(false)
  conductAgreementSignedAt DateTime?
  informationUpdateStatus  Int?
  parentId                 Int?
  LastSyncedAt             DateTime?
  Parent                   Parent?             @relation(fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  StudentAddress           StudentAddress[]
  StudentContact           StudentContact[]
  StudentEnrollment        StudentEnrollment[]
}

model StudentAddress {
  id           Int      @id @default(autoincrement())
  country      String?
  state        String?
  city         String?
  region       String?
  verified     Boolean  @default(false)
  zipCode      String?
  latitude     String?
  longitude    String?
  poBox        String?
  roadNumber   String?
  plotId       String?
  plotNumber   String?
  addressLine1 String?
  addressLine2 String?
  addressLine3 String?
  sector       String?
  studentId    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  IsPrimary    Boolean  @default(false, map: "DF__StudentAd__IsPri__3AD6B8E2")
  Student      Student  @relation(fields: [studentId], references: [id])
}

model StudentContact {
  id        Int      @id @default(autoincrement())
  type      String
  value     String
  studentId Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  IsPrimary Boolean  @default(false, map: "DF__StudentCo__IsPri__39E294A9")
  Student   Student  @relation(fields: [studentId], references: [id])
}

model StudentEnrollment {
  id                   Int       @id @default(autoincrement())
  orEnrollmentId       String    @unique
  type                 String?
  entryType            String?
  entryDate            DateTime?
  exitDate             DateTime?
  exitType             String?
  exitReason           String?
  isMandatoryEducation Boolean   @default(false)
  isSpecialNeed        Boolean   @default(false)
  educationType        String?
  schoolId             String?
  streamGradeId        String?
  studentId            Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  SchoolYear           String?   @db.NVarChar(50)
  Student              Student   @relation(fields: [studentId], references: [id])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  emirateId String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdBy String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UpdatePeriodConfig {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  startDate   DateTime @db.DateTime
  endDate     DateTime @db.DateTime
  isEnabled   Boolean  @default(false)
  description String?  @db.VarChar(Max)
  createdBy   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentActionConfig {
  id            Int      @id @default(autoincrement())
  educationType String   @db.VarChar(100)
  actionName    String   @db.NVarChar(255)
  actionKey     String   @db.VarChar(100)
  isEnabled     Boolean  @default(true)
  displayOrder  Int      @default(0)
  description   String?  @db.NVarChar(Max)
  configJson    String?  @db.NVarChar(Max)
  createdBy     String?  @db.VarChar(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([educationType, actionKey])
}

model AcademicYearConfig {
  id           Int      @id @default(autoincrement())
  academicYear String   @unique @db.VarChar(20)
  yearValue    Int
  isActive     Boolean  @default(false)
  description  String?  @db.VarChar(Max)
  createdBy    String?  @db.VarChar(64)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Parent {
  id                Int             @id @default(autoincrement())
  orSourcedId       String          @unique
  identifier        String?
  enabledUser       Boolean         @default(true)
  givenNameArabic   String?
  middleNameArabic  String?
  familyNameArabic  String?
  firstNameEnglish  String?
  secondNameEnglish String?
  thirdNameEnglish  String?
  familyNameEnglish String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  LastSyncedAt      DateTime?
  ParentContact     ParentContact[]
  Student           Student[]
}

model ParentContact {
  id        Int      @id @default(autoincrement())
  type      String
  value     String
  parentId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  IsPrimary Boolean  @default(false, map: "DF__ParentCon__IsPri__3BCADD1B")
  Parent    Parent   @relation(fields: [parentId], references: [id])
}

model EFMigrationsHistory {
  MigrationId    String @id(map: "PK___EFMigrationsHistory") @db.NVarChar(150)
  ProductVersion String @db.NVarChar(32)

  @@map("__EFMigrationsHistory")
}

model BackofficeSyncState {
  id            String   @id @db.VarChar(64)
  lastHistoryId BigInt   @default(0)
  updatedAt     DateTime
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    String    @db.VarChar(64)
  type      String    @db.VarChar(100)
  title     String    @db.VarChar(500)
  body      String    @db.VarChar(Max)
  data      String    @db.VarChar(Max)
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([createdAt])
  @@index([userId, isRead])
}

model ApiMetrics {
  Id                       Int      @id(map: "PK_ApiMetrics") @default(autoincrement())
  Endpoint                 String   @db.NVarChar(500)
  ServiceName              String?  @db.NVarChar(100)
  Timestamp                DateTime @default(dbgenerated("getutcdate()"), map: "DF__ApiMetric__Times__3EA749C6")
  AggregationPeriod        String   @db.NVarChar(20)
  TotalRequests            Int      @default(0, map: "DF__ApiMetric__Total__3F9B6DFF")
  SuccessfulRequests       Int      @default(0, map: "DF__ApiMetric__Succe__408F9238")
  FailedRequests           Int      @default(0, map: "DF__ApiMetric__Faile__4183B671")
  TimeoutErrors            Int      @default(0, map: "DF__ApiMetric__Timeo__4277DAAA")
  CircuitBreakerRejections Int      @default(0, map: "DF__ApiMetric__Circu__436BFEE3")
  NetworkErrors            Int      @default(0, map: "DF__ApiMetric__Netwo__4460231C")
  TotalRetries             Int      @default(0, map: "DF__ApiMetric__Total__45544755")
  SuccessfulRetries        Int      @default(0, map: "DF__ApiMetric__Succe__46486B8E")
  AvgResponseTime          Float    @default(0, map: "DF__ApiMetric__AvgRe__473C8FC7")
  MinResponseTime          Float    @default(0, map: "DF__ApiMetric__MinRe__4830B400")
  MaxResponseTime          Float    @default(0, map: "DF__ApiMetric__MaxRe__4924D839")
  P50ResponseTime          Float?
  P95ResponseTime          Float?
  P99ResponseTime          Float?
  StatusCodeBreakdown      String?  @db.NVarChar(Max)
  CreatedAt                DateTime @default(dbgenerated("getutcdate()"), map: "DF__ApiMetric__Creat__4A18FC72")
  UpdatedAt                DateTime @default(dbgenerated("getutcdate()"), map: "DF__ApiMetric__Updat__4B0D20AB")

  @@index([AggregationPeriod, Timestamp(sort: Desc)], map: "IX_ApiMetrics_AggregationPeriod_Timestamp")
  @@index([Endpoint, Timestamp(sort: Desc)], map: "IX_ApiMetrics_Endpoint_Timestamp")
  @@index([Timestamp(sort: Desc), Endpoint], map: "IX_ApiMetrics_Timestamp_Endpoint")
}

model CircuitBreakerMetrics {
  Id              Int      @id @default(autoincrement())
  Name            String   @db.NVarChar(100)
  State           String   @db.NVarChar(20)
  Failures        Int      @default(0)
  Successes       Int      @default(0)
  Rejections      Int      @default(0)
  LastFailureTime DateTime?
  LastSuccessTime DateTime?
  NextAttemptTime DateTime?
  Timestamp       DateTime @default(dbgenerated("getutcdate()"))
  
  @@index([Name, Timestamp(sort: Desc)])
}

model QueueMetrics {
  Id                  Int      @id @default(autoincrement())
  QueueName           String   @db.NVarChar(100)
  CurrentPending      Int      @default(0)
  CurrentQueueSize    Int      @default(0)
  SuccessfulRequests  Int      @default(0)
  FailedRequests      Int      @default(0)
  RetriedRequests     Int      @default(0)
  SuccessRate         String?  @db.NVarChar(20)
  Timestamp           DateTime @default(dbgenerated("getutcdate()"))
  
  @@index([QueueName, Timestamp(sort: Desc)])
}

