{
  "name": "parentportal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4200",
    "build": "next build --turbopack",
    "start": "next start -p 4200",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "prisma:pp:push": "prisma db push --schema=prisma/parent-portal/schema.prisma",
    "prisma:pp:pull": "prisma db pull --schema=prisma/parent-portal/schema.prisma",
    "prisma:pp:generate": "prisma generate --schema=prisma/parent-portal/schema.prisma",
    "prisma:sr:generate": "prisma generate --schema=prisma/student-registration/schema.prisma",
    "prisma:gen:all": "npm run prisma:pp:generate && npm run prisma:sr:generate"
  },
  "dependencies": {
    "@aegov/design-system": "^2.2.10",
    "@fontsource/noto-kufi-arabic": "^5.2.9",
